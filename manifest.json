{
  "manifest_version": 3,
  "name": "__MSG_nome__",
  "description": "__MSG_descrizione__",
  "version": "0.2.0",
  "default_locale": "it",
  "minimum_chrome_version": "116",
  "permissions": [
    "contextMenus",
    "downloads",
    "notifications",
    "storage"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "sfondo.js"
  },
  "icons": {
    "16": "icone/16.png",
    "32": "icone/32.png",
    "48": "icone/48.png",
    "128": "icone/128.png"
  },
  "options_ui": {
    "page": "impostazioni.html",
    "open_in_tab": false
  }
}
